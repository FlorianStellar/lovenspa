{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Plan",
  "description": "S4 : plan d'une semaine pour une plateforme.",
  "type": "object",
  "required": [
    "semaine",
    "plateforme",
    "cases",
    "alertes"
  ],
  "properties": {
    "semaine": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "plateforme": {
      "type": "string",
      "enum": [
        "instagram",
        "tiktok",
        "pinterest"
      ]
    },
    "cases": {
      "type": "array",
      "items": {
        "$ref": "case.schema.json"
      }
    },
    "alertes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true,
  "$id": "plan.schema.json"
}