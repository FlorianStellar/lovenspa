{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Paquet",
  "description": "S5 -> S6, S7 : textes et médias d'une case.",
  "type": "object",
  "required": [
    "case",
    "legende",
    "medias"
  ],
  "properties": {
    "case": {
      "$ref": "case.schema.json"
    },
    "legende": {
      "type": "string",
      "minLength": 1
    },
    "medias": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "ia_photorealiste": {
      "type": "boolean",
      "description": "Au moins un média photoréaliste généré ou modifié par IA : label « AI info » obligatoire (IG-R30, IG-R31)."
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true,
  "$id": "paquet.schema.json"
}