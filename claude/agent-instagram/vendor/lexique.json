  "structures": [
    {
      "id": "pas-juste",
      "regex": "(?i)\\b(?:ce n['’]|c['’])est (?:pas )?(?:juste|seulement|simplement|uniquement) [^.!?\\n]{2,60}[,.] c['’]est\\b",
      "name": "« Ce n'est pas juste X, c'est Y »",
      "fix": "Dis la seule chose que tu veux dire. Supprime la moitié qui sert de mise en place."
    },
    {
      "id": "non-seulement",
      "regex": "(?i)\\bnon seulement\\b[^.!?\\n]{2,80}\\bmais (?:aussi|également)\\b",
      "name": "« Non seulement X mais aussi Y »",
      "fix": "Coupe en deux phrases, ou garde la moitié la plus forte."
    },
    {
      "id": "il-ne-sagit-pas",
      "regex": "(?i)\\bil ne s['’]agit pas de [^.!?\\n]{2,60}[.!,] (?:il s['’]agit|c['’]est)\\b",
      "name": "« Il ne s'agit pas de X. Il s'agit de Y. »",
      "fix": "Commence par Y. Le retournement est le tic."
    },
    {
      "id": "le-resultat",
      "regex": "(?im)^\\s*(?:le résultat|la suite|le secret|le pire|le meilleur|la raison|le problème|la clé)\\s?\\?\\s*$",
      "name": "Question rhétorique sur une ligne seule",
      "fix": "Réponds directement au lieu de mettre en scène une révélation."
    },
    {
      "id": "voici-ce-que",
      "regex": "(?i)\\b(?:voici|voilà) ce que (?:j['’]ai|nous avons|on a) appris\\b",
      "name": "« Voici ce que j'ai appris »",
      "fix": "Donne la leçon. Saute l'annonce."
    },
