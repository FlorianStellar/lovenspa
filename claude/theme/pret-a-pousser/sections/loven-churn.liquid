{%- comment -%}
  sections/loven-churn.liquid
  Fiche d'un hebergement qui n'est plus partenaire (template product.produit-churn).
  La fiche garde son contenu (photos, description, equipements, FAQ, avis)
  pour rester positionnee dans Google ; la reservation, le prix et le contact
  sont retires par product-full-width (garde is_churn). Cette section renvoie
  le visiteur vers des love rooms partenaires proches. Pas de H1 ici : le
  titre de la fiche est porte par le bloc titre de product-full-width.

  Zone : meme resolution que loven-proximite (ville, sinon departement, sinon
  region, depuis les metaobjets). Une zone n'est retenue que si elle contient
  assez de rooms pour remplir la grille, une fois retirees la fiche courante
  et les autres fiches churn.

  Toute fiche portant le template produit-churn est exclue de la grille :
  on ne renvoie jamais un visiteur vers une autre fiche churn.
{%- endcomment -%}

{%- liquid
  assign churn_suffix = 'produit-churn'
  assign lim = section.settings.count | default: 6

  assign region_name = product.metafields.custom.region_collection.value.region.value | default: ''
  assign dept_name = ''
  assign dept_list = product.metafields.custom.departement_list.value
  if dept_list != blank
    assign dept_mo = dept_list | first
    assign dept_name = dept_mo.name.value | default: ''
  endif
  assign ville_name = product.metafields.accentuate.ville | default: ''

  assign region_h = region_name | handleize
  assign dept_h = dept_name | handleize
  assign ville_h = ville_name | handleize

  assign region_handle = ''
  assign dept_handle = ''
  assign ville_handle = ''
  for c in product.collections
    assign ch = c.title | handleize
    if region_handle == blank and region_h != blank and ch == region_h
      assign region_handle = c.handle
    endif
    if dept_handle == blank and dept_h != blank and ch == dept_h
      assign dept_handle = c.handle
    endif
    if ville_handle == blank and ville_h != blank and ch == ville_h
      assign ville_handle = c.handle
    endif
  endfor
  if ville_handle == blank
    for mo in product.metafields.custom.ville_collection_list.value
      assign mh = mo.name.value | handleize
      for c in product.collections
        assign ch = c.title | handleize
        if ville_handle == blank and ch == mh
          assign ville_handle = c.handle
        endif
      endfor
    endfor
  endif

  comment
    Seuil : lim + 1 pour compter la fiche courante. Les autres fiches churn
    ne sont connues qu'a la boucle ; si elles vident la grille, le repli
    sur la zone suivante se fait plus bas (zone_fallback).
  endcomment
  assign seuil = lim | plus: 1
  assign zone = collections[ville_handle]
  assign zone_fallback = collections[dept_handle]
  if zone == blank or zone.products_count < seuil
    assign zone = collections[dept_handle]
    assign zone_fallback = collections[region_handle]
  endif
  if zone == blank or zone.products_count < seuil
    assign zone = collections[region_handle]
    assign zone_fallback = nil
  endif
  if zone == blank
    assign zone = collections['tous-les-hebergements-1']
    assign zone_fallback = nil
  endif

  assign shown = 0
  assign seen = ','
  assign ld_items = ''
  capture cards
    for p in zone.products limit: 50
      if shown >= lim
        break
      endif
      if p.id == product.id or p.template_suffix == churn_suffix
        continue
      endif
      assign shown = shown | plus: 1
      assign seen = seen | append: p.id | append: ','
      echo '<div class="lvn-churn__card">'
      render 'product-grid-item', product: p, grid_image_index: 99, no_actions: true, classes: 'lvn-churn__item'
      echo '</div>'
      assign u = shop.url | append: p.url
      capture li
        echo '{"@type":"ListItem","position":'
        echo shown
        echo ',"url":'
        echo u | json
        echo ',"name":'
        echo p.title | json
        echo '}'
      endcapture
      if ld_items != blank
        assign ld_items = ld_items | append: ','
      endif
      assign ld_items = ld_items | append: li
    endfor

    if shown < lim and zone_fallback != blank
      for p in zone_fallback.products limit: 50
        if shown >= lim
          break
        endif
        assign key = ',' | append: p.id | append: ','
        if seen contains key or p.id == product.id or p.template_suffix == churn_suffix
          continue
        endif
        assign shown = shown | plus: 1
        assign seen = seen | append: p.id | append: ','
        echo '<div class="lvn-churn__card">'
        render 'product-grid-item', product: p, grid_image_index: 99, no_actions: true, classes: 'lvn-churn__item'
        echo '</div>'
        assign u = shop.url | append: p.url
        capture li
          echo '{"@type":"ListItem","position":'
          echo shown
          echo ',"url":'
          echo u | json
          echo ',"name":'
          echo p.title | json
          echo '}'
        endcapture
        if ld_items != blank
          assign ld_items = ld_items | append: ','
        endif
        assign ld_items = ld_items | append: li
      endfor
    endif
  endcapture

  assign lieu = ville_name
  if lieu == blank
    assign lieu = dept_name | default: region_name
  endif
-%}

<div class="lvn-churn" id="lvn-churn" data-lvn-churn>
  <div class="page-width">
    <div class="lvn-churn__head">
      <p class="lvn-churn__eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="lvn-churn__title">{{ section.settings.heading }}</h2>
      <p class="lvn-churn__lead">
        {%- if lieu != blank -%}
          {{ section.settings.lead_lieu | replace: '[nom]', product.title | replace: '[lieu]', lieu | escape }}
        {%- else -%}
          {{ section.settings.lead | replace: '[nom]', product.title | escape }}
        {%- endif -%}
      </p>
      {%- assign lr = collections['love-room'] -%}
      {%- if lr != blank and lr.products_count > 0 -%}
        <p class="lvn-churn__more">
          Retrouvez toute notre sélection <a href="{{ lr.url }}" data-loven-link="churn-love-room">love room</a> en France, adresse par adresse.
        </p>
      {%- endif -%}
    </div>

    {%- if shown > 0 -%}
      <div class="lvn-churn__grid" data-lvn-churn-grid data-count="{{ shown }}">
        {{ cards }}
      </div>
    {%- endif -%}

    <div class="lvn-churn__ctas">
      {%- if zone != blank and zone.handle != 'tous-les-hebergements-1' -%}
        <a class="lvn-churn__btn lvn-churn__btn--primary" href="{{ zone.url }}" data-loven-link="churn-zone">
          Love rooms : {{ zone.title }}
        </a>
      {%- endif -%}
      <a class="lvn-churn__btn" href="{{ collections['tous-les-hebergements-1'].url | default: routes.all_products_collection_url }}" data-loven-link="churn-tout">
        Toutes nos love rooms
      </a>
    </div>
  </div>
</div>

{%- if shown > 0 -%}
  <script type="application/ld+json">
    {"@context":"https://schema.org","@type":"ItemList","name":{{ section.settings.heading | json }},"numberOfItems":{{ shown }},"itemListElement":[{{ ld_items }}]}
  </script>
{%- endif -%}

<style>
  #lvn-churn.lvn-churn{padding:40px 0 56px;background:#FBF6F2;font-family:Poppins,sans-serif;color:#222222}
  #lvn-churn .lvn-churn__head{max-width:720px;margin:0 auto 32px;text-align:center}
  #lvn-churn .lvn-churn__eyebrow{margin:0 0 12px;font-size:13px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:#6c6c6c}
  #lvn-churn .lvn-churn__title{margin:0 0 12px;font-size:28px;line-height:1.25;font-weight:700}
  #lvn-churn .lvn-churn__lead{margin:0;font-size:16px;line-height:1.6;color:#444444}
  #lvn-churn .lvn-churn__more{margin:12px 0 0;font-size:15px;line-height:1.6;color:#444444}
  #lvn-churn .lvn-churn__more a{color:#E83F4E;font-weight:700;text-decoration:underline}
  #lvn-churn .lvn-churn__ctas{display:flex;flex-wrap:wrap;justify-content:center;gap:12px;margin-top:32px}
  #lvn-churn .lvn-churn__btn{display:inline-block;padding:14px 24px;border:1px solid #222222;border-radius:999px;background:#FFFFFF;color:#222222;font-size:14px;font-weight:700;text-decoration:none}
  #lvn-churn .lvn-churn__btn:hover{border-color:#E83F4E;color:#E83F4E}
  #lvn-churn .lvn-churn__btn--primary{background:#E83F4E;border-color:#E83F4E;color:#FFFFFF}
  #lvn-churn .lvn-churn__btn--primary:hover{background:#FFFFFF;color:#E83F4E}
  #lvn-churn .lvn-churn__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}
  #lvn-churn .lvn-churn__card .grid-item{width:100%;margin:0;padding:0}
  @media (max-width:989px){#lvn-churn .lvn-churn__grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}}
  @media (max-width:749px){
    #lvn-churn.lvn-churn{padding:28px 0 40px}
    #lvn-churn .lvn-churn__title{font-size:22px}
    #lvn-churn .lvn-churn__lead{font-size:15px}
    #lvn-churn .lvn-churn__grid{grid-template-columns:minmax(0,1fr)}
    #lvn-churn .lvn-churn__btn{width:100%;text-align:center}
  }
</style>

{% schema %}
{
  "name": "Fiche non partenaire",
  "templates": ["product"],
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Non réservable sur Love'nSpa" },
    { "type": "textarea", "id": "lead_lieu", "label": "Texte (avec lieu)", "default": "[nom] ne prend plus de réservations via Love'nSpa. Ces love rooms partenaires, autour de [lieu], sont réservables dès maintenant.", "info": "[nom] : titre de la fiche. [lieu] : ville, sinon département, sinon région." },
    { "type": "textarea", "id": "lead", "label": "Texte (sans lieu)", "default": "[nom] ne prend plus de réservations via Love'nSpa. Ces love rooms partenaires sont réservables dès maintenant." },
    { "type": "text", "id": "heading", "label": "Titre de la grille", "default": "Love rooms disponibles à proximité" },
    { "type": "range", "id": "count", "label": "Nombre de rooms", "min": 3, "max": 12, "step": 3, "default": 6 }
  ],
  "presets": [{ "name": "Fiche non partenaire" }]
}
{% endschema %}
