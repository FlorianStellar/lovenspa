{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Case",
  "description": "S4 -> S5 : une publication à produire.",
  "type": "object",
  "required": [
    "date",
    "heure",
    "plateforme",
    "moteur",
    "format",
    "statut"
  ],
  "properties": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "heure": {
      "type": "string",
      "pattern": "^\\d{2}:\\d{2}$"
    },
    "plateforme": {
      "type": "string",
      "enum": [
        "instagram",
        "tiktok",
        "pinterest"
      ]
    },
    "moteur": {
      "type": "string",
      "enum": [
        "lieu",
        "selection",
        "concours",
        "couple",
        "story",
        "recrutement"
      ]
    },
    "format": {
      "type": "string",
      "enum": [
        "REELS",
        "CAROUSEL",
        "IMAGE",
        "STORY",
        "PIN",
        "TIKTOK"
      ]
    },
    "temps_fort": {
      "type": [
        "string",
        "null"
      ]
    },
    "statut": {
      "type": "string",
      "enum": [
        "A_PRODUIRE",
        "BLOQUE"
      ]
    },
    "offres": {
      "type": "array",
      "items": {
        "$ref": "offre.schema.json"
      }
    },
    "theme": {
      "type": [
        "string",
        "null"
      ]
    },
    "region": {
      "type": [
        "string",
        "null"
      ]
    },
    "lien": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true,
  "$id": "case.schema.json"
}