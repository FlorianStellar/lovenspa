{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verdict",
  "description": "S6 -> S7, S8 : résultat du contrôle d'un Paquet.",
  "type": "object",
  "required": [
    "statut",
    "bloquants",
    "controle"
  ],
  "properties": {
    "statut": {
      "type": "string",
      "enum": [
        "PRET",
        "REFUSE"
      ]
    },
    "bloquants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "controle": {
      "type": "object",
      "required": [
        "resultats"
      ]
    }
  },
  "additionalProperties": true,
  "$id": "verdict.schema.json"
}